{
  "expo": {
    "name": "Temple TV",
    "slug": "temple-tv-mobile",
    "version": "1.0.71",
    "version": "1.0.72",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "templetv",
    "userInterfaceStyle": "light",
    "description": "Stream live worship, sermons, and teachings from Temple TV JCTM Broadcasting — Jesus Christ Temple Ministry.",
    "owner": "mobileapptemples-team",
    "primaryColor": "#6A0DAD",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.templetv.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "202607291201",
      "requireFullScreen": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "AVAudioSessionCategory": "AVAudioSessionCategoryPlayback",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSUserNotificationsUsageDescription": "Temple TV uses notifications to alert you when a live broadcast or new sermon is available.",
        "NSPhotoLibraryUsageDescription": "Temple TV needs access to your photo library so you can choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Temple TV can save shared content to your photo library.",
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel",
          "sms"
        ]
      },
      "associatedDomains": [
        "applinks:templetv.org.ng",
        "applinks:www.templetv.org.ng"
      ]
    },
    "android": {
      "package": "com.templetv.jctm",
      "versionCode": 139,
      "versionCode": 140,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#6A0DAD",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "templetv.org.ng",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.templetv.org.ng",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "templetv",
              "host": "*"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "userInterfaceStyle": "light",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-audio",
      "expo-video",
      [
        "expo-router",
        {
          "origin": "https://templetv.org.ng"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#6A0DAD",
          "dark": {
            "backgroundColor": "#3A0060"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6A0DAD",
          "sounds": [],
          "mode": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Temple TV needs access to your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Temple TV to use Face ID to keep your account signed in securely."
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "project": "temple-tv-mobile",
          "organization": "templetv",
          "autoUploadProguardMapping": true,
          "uploadNativeSymbols": true,
          "autoUploadNativeSymbols": false,
          "includeNativeSources": false,
          "includeSourceContext": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.2.12479018",
            "kotlinVersion": "2.1.20",
            "jvmArgs": "-Xmx4g -XX:MaxMetaspaceSize=512m -XX:+UseParallelGC -XX:+HeapDumpOnOutOfMemoryError",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "extraProguardRules": "# Library JNI/reflection rules are supplied by their consumer configurations.\n# Keep symbolication metadata, not entire library implementations.\n-keepattributes SourceFile,LineNumberTable,Signature,*Annotation*,InnerClasses,EnclosingMethod\n-renamesourcefileattribute SourceFile\n# App-owned Expo modules: preserve construction while allowing optimization.\n-keep,allowoptimization,allowobfuscation class expo.modules.pipandroid.ExpoPipAndroidModule {\n  public <init>();\n  public expo.modules.kotlin.modules.ModuleDefinitionData definition();\n}\n-keep,allowoptimization,allowobfuscation class expo.modules.inappupdates.ExpoInAppUpdatesModule {\n  public <init>();\n  public expo.modules.kotlin.modules.ModuleDefinitionData definition();\n}",
            "enableMinifyInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/android-tv.js",
      "./plugins/with-kotlin-version.js",
      "./plugins/with-modern-gradle-dsl.js",
      "./plugins/with-gradle-config.js",
      "./plugins/with-play-upload-signing.js",
      "./plugins/with-release-r8.js",
      "./plugins/with-foreground-service-type.js",
      "./plugins/with-16kb-page-size.js",
      "./plugins/with-android-activity-flags.js",
      "./plugins/with-enable-edge-to-edge.js",
      "./plugins/with-edge-to-edge.js",
      "./plugins/with-large-heap.js",
      "./plugins/with-predictive-back.js",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
       ]
     ],
    "extra": {
      "router": {
        "origin": "https://templetv.org.ng"
      },
      "eas": {
        "projectId": "ba257199-c9f3-451d-881c-5b3dbedda746"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
